{
  "name": "sanjog-learning-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "clean": "rimraf .next node_modules",
    "lint:fix": "eslint src --fix",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test:backend": "python -m pytest backend/tests -q",
    "test:model": "node --import tsx scripts/test-recognizer.ts",
    "export:model": "python backend/export_model.py"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.18.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tensorflow-models/handpose": "^0.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "motion": "^12.9.1",
    "next": "^15.5.19",
    "next-themes": "^0.4.6",
    "react": "^18",
    "react-dom": "^18",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.25.1",
    "@next/eslint-plugin-next": "^15.5.19",
    "@swc/core": "^1.11.22",
    "@swc/helpers": "^0.5.17",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "regenerator-runtime": "^0.14.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0"
  }
}
