# Sanjog recognition backend — copy to backend/.env for local development.
# Optional: only for running the reference Flask server locally (not deployed).

# Port to listen on (Spaces uses 7860)
PORT=7860

# Never "true" in production
FLASK_DEBUG=false

# Comma-separated CORS allow-list. Empty = http://localhost:3000 only.
FRONTEND_ORIGIN=http://localhost:3000

# Max /predict requests per minute per client IP
RATELIMIT_PER_MINUTE=900

# Shared with Vercel. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
RECOGNITION_SIGNING_SECRET=

# Optional: absolute path to model.p (default backend/models/model.p)
# MODEL_PATH=
